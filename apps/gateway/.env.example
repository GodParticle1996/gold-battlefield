# GOLD BATTLEFIELD — gateway environment template.
# All values are OPTIONAL for the free, keyless default setup
# (simulation and replay work with zero configuration).

# Port the gateway listens on (HTTP health + WebSocket upgrade).
PORT=8081

# --- Binance (MODE A) ---------------------------------------------------------
# Public, unauthenticated market-data endpoints. Swap in data-stream.binance.vision
# or data-api.binance.vision for market-data-only hosts if needed.
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_REST_URL=https://api.binance.com

# --- Kraken (MODE B) -----------------------------------------------------------
KRAKEN_WS_URL=wss://ws.kraken.com/v2
COINBASE_WS_URL=wss://ws-feed.exchange.coinbase.com
GEMINI_WS_URL=wss://api.gemini.com/v1/marketdata/PAXGUSD
BITSTAMP_WS_URL=wss://ws.bitstamp.net
BITSTAMP_REST_URL=https://www.bitstamp.net

# --- Swissquote reference price (MODE D) ---------------------------------------
# Keyless public BBO endpoint; polled conservatively (spec: never call polled
# data real-time — the UI labels this mode accordingly).
SWISSQUOTE_URL=https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument/XAU/USD
SWISSQUOTE_POLL_MS=5000

# --- Replay (MODE F) ----------------------------------------------------------
# Path to a replay fixture JSON (default resolves to tests/fixtures/replay-xaut-1.json).
# REPLAY_FIXTURE=../tests/fixtures/replay-xaut-1.json

# --- Origin control (spec §15) ------------------------------------------------
# Comma-separated allowed browser origins for the WebSocket upgrade, or * for any.
# Set to your deployed origin in production (e.g. https://gold-battlefield.example.com).
ALLOWED_ORIGINS=*

# Structured log level.
LOG_LEVEL=info
